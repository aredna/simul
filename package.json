{
  "name": "simul",
  "version": "0.4.0",
  "private": true,
  "description": "Follow a web page in a live read-only mirror with on-device translation in Chrome.",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build --browser chrome",
    "artifact:sync": "node tools/extension-artifact.mjs sync",
    "artifact:check": "node tools/extension-artifact.mjs check",
    "zip": "wxt zip --browser chrome",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run artifact:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "acorn": "^8.18.0",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "tesseract.js": false
  },
  "dependencies": {
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}

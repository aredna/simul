{
  "name": "simul",
  "version": "0.3.2",
  "private": true,
  "description": "Follow a web page in a live read-only mirror with on-device translation in Chrome.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build --browser chrome",
    "artifact:sync": "node tools/extension-artifact.mjs sync",
    "artifact:check": "node tools/extension-artifact.mjs check",
    "check:ocr-paddle-trial": "node tools/extension-artifact.mjs check-ocr-paddle-trial",
    "check:ocr-all-trial": "node tools/extension-artifact.mjs check-ocr-all-trial",
    "artifact:sync:ocr-trials": "node tools/extension-artifact.mjs sync-ocr-all-trial",
    "vendor:ocr-paddle": "node tools/vendor-paddle-ocr.mjs",
    "vendor:ocr-tesseract-wasm": "node tools/vendor-tesseract-wasm.mjs",
    "zip": "wxt zip --browser chrome",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run artifact:check"
  },
  "devDependencies": {
    "acorn": "8.17.0",
    "linkedom": "0.18.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "fx-runner": "1.5.0",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@rrweb/record": "2.1.0",
    "@rrweb/replay": "2.1.0",
    "onnxruntime-web": "1.24.3",
    "tesseract-wasm": "0.11.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}

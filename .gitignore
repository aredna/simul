# Dependencies and generated extension output
node_modules/
.output/
.wxt/
coverage/
*.crx
*.zip

# Track only the canonical, validated builds under dist: the public edition
# (chrome-unpacked) and the owner's dev edition (chrome-dev, private only).
dist/
!dist/
dist/*
!dist/chrome-unpacked/
!dist/chrome-unpacked/**
!dist/chrome-dev/
!dist/chrome-dev/**

# Local environment and editor files
.env
.env.*
!.env.example
.envrc
.direnv/
.idea/
.vscode/
.cache/
tmp/
.DS_Store
*.log

# Local credentials and signing material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# BMAD personal configuration; team configuration and artifacts are tracked.
_bmad/config.user.toml
_bmad/custom/*.user.toml

# Tesseract cores are embedded in the vendored .wasm.js loaders; separate
# .wasm copies are stray and would breach the artifact size gate.
vendor/ocr/tesseract/core/*.wasm

# Local tool settings and worktrees.
.claude/
